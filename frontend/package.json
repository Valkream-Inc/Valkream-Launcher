{
  "name": "Valkream-Launcher",
  "version": "2.4.5",
  "type": "module",
  "description": "Launcher Multi-Gaming moddé pour Valkream (Valheim, 7 Days To Die, etc.)",
  "author": "Valkream Team",
  "scripts": {
    "dev:react": "cross-env BROWSER=none PORT=8080 vite",
    "dev:main": "tsx scripts/dev-main.ts",
    "dev:electron": "wait-on tcp:8080 file:.tsbuild/app.js && nodemon --watch .tsbuild --ext js,cjs,json --exec \"cross-env NODE_ENV=dev electron .tsbuild/app.js\"",
    "dev:types:main": "tsc -p main/tsconfig.json --noEmit --watch --preserveWatchOutput",
    "dev:types:renderer": "tsc -p renderer/tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "concurrently -n main,tests,renderer,scripts \"yarn typecheck:main\" \"yarn typecheck:tests\" \"yarn typecheck:renderer\" \"yarn typecheck:scripts\"",
    "typecheck:main": "tsc -p main/tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p main/tsconfig.test.json && tsc -p renderer/tsconfig.test.json",
    "test": "tsx --test \"main/src/**/*.test.ts\" \"renderer/src/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "typecheck:renderer": "tsc -p renderer/tsconfig.json",
    "typecheck:scripts": "tsc -p tsconfig.json",
    "depot:pin": "tsx scripts/pin-depotdownloader.ts",
    "build:manifest": "tsx scripts/build-manifest.ts",
    "set-icon": "tsx set-icon.ts",
    "build": "yarn set-icon && yarn build:compile && yarn build:electron && yarn check:build && yarn check:runtime",
    "build:compile": "concurrently -n react,main \"yarn build:react\" \"yarn build:main\"",
    "build:react": "vite build",
    "build:main": "yarn clean:main && tsc -p main/tsconfig.json --sourceMap false",
    "build:electron": "tsx build-script.ts --obf=true",
    "check:build": "tsx scripts/check-build.ts",
    "check:runtime": "tsx scripts/check-runtime.ts",
    "clean:main": "node -e \"require('node:fs').rmSync('.tsbuild',{recursive:true,force:true})\""
  },
  "license": "MIT-NC",
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.12",
    "gamedig": "^5.3.3",
    "unzipper": "^0.12.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@types/unzipper": "^0.10.11",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.4.1",
    "electron-builder": "26.18.1",
    "esbuild": "^0.28.2",
    "i18next": "^27.2.3",
    "javascript-obfuscator": "^5.10.1",
    "jimp": "^1.6.1",
    "node-fetch": "^3.3.2",
    "nodemon": "^3.1.14",
    "notistack": "^3.0.2",
    "png2icons": "^2.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "react-router-dom": "^7.18.6",
    "three": "^0.187.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "wait-on": "^9.5.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Valkream-Inc/Valkream-Launcher.git"
  }
}
