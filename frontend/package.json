{
  "name": "Valkream-Launcher",
  "version": "2.4.5",
  "description": "Launcher Multi-Gaming moddé pour Valkream (Valheim, 7 Days To Die, etc.)",
  "author": "Valkream Team",
  "scripts": {
    "start": "concurrently \"yarn run start:react\" \"yarn run start:electron\"",
    "start:react": "cross-env BROWSER=none cross-env PORT=8080 vite",
    "start:electron": "cross-env NODE_ENV=dev electron ./main/app.js",
    "dev": "yarn run rebuild && concurrently \"yarn run dev:react\" \"yarn run dev:electron\"",
    "dev:react": "yarn run start:react",
    "dev:electron": "wait-on http://localhost:8080 && nodemon --exec yarn run start:electron",
    "set-icon": "node set-icon.js",
    "build": "yarn run set-icon && yarn run build:react && yarn run build:electron",
    "build:react": "vite build",
    "build:electron": "node ./build-script.js --obf=true",
    "rebuild": "electron-rebuild"
  },
  "license": "MIT-NC",
  "nodemonConfig": {
    "ext": "js,json",
    "ignore": "**/src/renderer/**"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "axios": "^1.21.1",
    "better-sqlite3": "^13.2.0",
    "crypto": "^1.0.1",
    "electron-updater": "6.8.11",
    "fs": "^0.0.1-security",
    "fs-extra": "^11.4.1",
    "gamedig": "^5.3.3",
    "notistack": "^3.0.2",
    "path": "^0.12.7",
    "progress-stream": "^2.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "stream-throttle": "^0.1.3",
    "three": "^0.187.0",
    "unzipper": "^0.12.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.2",
    "electron-builder": "26.18.0",
    "electron-rebuild": "^3.2.9",
    "javascript-obfuscator": "^5.10.1",
    "jimp": "^1.6.1",
    "node-fetch": "^3.3.2",
    "nodemon": "^3.1.14",
    "png2icons": "^2.0.1",
    "vite": "^8.3.8",
    "wait-on": "^9.5.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Valkream-Inc/Valkream-Launcher.git"
  }
}
