{
  // Scripts Node du frontend (vite.config.ts, build-script.ts, set-icon.ts).
  // Les sources ont leur propre tsconfig : main/tsconfig.json et renderer/tsconfig.json.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "noEmit": true,
    // Les scripts importent du code du main qui utilise l'alias @shared/types (comme main/tsconfig.json)
    "paths": {
      "@shared/types": ["./shared/types/index.js"],
      "@shared/*": ["./shared/*"]
    }
  },
  "include": ["vite.config.ts", "build-script.ts", "set-icon.ts", "scripts/**/*.ts", "types/**/*.d.ts", "shared/**/*.d.ts"]
}
