{
  "name": "Valkream-Launcher-Infra",
  "description": "Launcher Multi-Gaming moddé pour Valkream",
  "license": "MIT-NC",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=26.13.1"
  },
  "workspaces": {
    "packages": [
      "./backend",
      "./frontend"
    ]
  },
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.30.5",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "turbo": "^2.11.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "scripts": {
    "dev": "turbo run dev:back dev:react dev:main dev:electron dev:types:main dev:types:renderer --concurrency=12",
    "dev:fast": "turbo run dev dev:react dev:main dev:electron --concurrency=12",
    "dev:front": "turbo run dev:react dev:main dev:electron dev:types:main dev:types:renderer --filter=Valkream-Launcher --concurrency=12",
    "dev:back": "turbo run dev:back",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Valkream-Inc/Valkream-Launcher.git"
  }
}
