{
  "name": "Valkream-Launcher-Infra",
  "description": "Launcher Multi-Gaming moddé pour Valkream",
  "license": "MIT-NC",
  "private": true,
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=22.17.0"
  },
  "workspaces": {
    "packages": [
      "./backend",
      "./frontend"
    ],
    "nohoist": [
      "**/better-sqlite3",
      "**/better-sqlite3/**"
    ]
  },
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.30.2",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "turbo": "^2.11.11",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.72.2"
  },
  "scripts": {
    "dev": "turbo run dev dev:react dev:main dev:electron dev:types:main dev:types:renderer --concurrency=12",
    "dev:fast": "turbo run dev dev:react dev:main dev:electron --concurrency=12",
    "dev:front": "turbo run dev:react dev:main dev:electron dev:types:main dev:types:renderer --filter=Valkream-Launcher --concurrency=12",
    "dev:back": "turbo run dev --filter=dev-file-server",
    "dev:fresh": "yarn rebuild && yarn dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "rebuild": "yarn workspace Valkream-Launcher rebuild"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Valkream-Inc/Valkream-Launcher.git"
  }
}
