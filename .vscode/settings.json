{
  // TypeScript : version installée par Yarn (nodeLinker: node-modules).
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "js/ts.suggest.autoImports": true,
  "js/ts.updateImportsOnFileMove.enabled": "always",

  // Imports : alias (@, @shared) sans extension, `import type` quand c'est un type.
  "js/ts.preferences.importModuleSpecifier": "non-relative",
  "js/ts.preferences.importModuleSpecifierEnding": "minimal",
  "js/ts.preferences.preferTypeOnlyAutoImports": true,
  "js/ts.preferences.includePackageJsonAutoImports": "on",
  "js/ts.preferences.useAliasesForRenames": true,
  "js/ts.preferences.quoteStyle": "double",
  "js/ts.preferences.renameMatchingJsxTags": true,
  "js/ts.preferences.autoImportFileExcludePatterns": [
    "**/.tsbuild/**",
    "**/build/**",
    "**/dist/**",
    "**/node_modules/@types/**"
  ],

  "editor.codeActionsOnSave": {
    "source.addMissingImports": "explicit",
    "source.organizeImports": "explicit",
    "source.removeUnusedImports": "explicit",
    "source.fixAll.eslint": "explicit"
  },
  // ESLint 10 n'utilise que la flat config (eslint.config.mjs) : eslint.useFlatConfig est ignoré.
  "eslint.workingDirectories": [{ "mode": "auto" }],

  // json for package
  "json.schemaDownload.enable": true,

  // Aucun artefact Yarn / build dans la recherche ni dans le watcher.
  "search.exclude": {
    "**/node_modules": true,
    "**/.yarn": true,
    "**/.turbo": true,
    "**/.tsbuild": true,
    "**/build": true,
    "**/dist": true,
    "**/yarn.lock": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.yarn/**": true,
    "**/.turbo/**": true,
    "**/.tsbuild/**": true,
    "**/build/**": true,
    "**/dist/**": true
  },

  // Pour masquer des fichiers dans l'explorateur :
  "files.exclude": {
    "**/node_modules/": true,
    "**/.tsbuild/": true,
    "**/build/": true,
    "**/dist/": true,
    "**/temp/": true,
    "**/LICENSE": true,
    "**/LICENSE.md": true,
    "**/.gitattributes": true,
    "**/yarn.lock": true,
    "**/.yarn": true,
    "**/.turbo": true
  }
}
